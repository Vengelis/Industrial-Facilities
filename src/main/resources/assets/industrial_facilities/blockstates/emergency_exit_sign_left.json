      },
      "apply": {
        "model": "industrial_facilities:block/emergency_exit_sign_left_1",
        "y": 90
      }
    },
    {
      "when": {
        "mount": "ceiling",
        "facing": "down",
        "horizontal_facing": "south"
      },
      "apply": {
        "model": "industrial_facilities:block/emergency_exit_sign_left_1",
        "y": 180
      }
    },
    {
      "when": {
        "mount": "ceiling",
        "facing": "down",
        "horizontal_facing": "west"
      },
      "apply": {
        "model": "industrial_facilities:block/emergency_exit_sign_left_1",
        "y": 270
